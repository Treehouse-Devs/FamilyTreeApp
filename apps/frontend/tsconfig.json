{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-native",
    "noEmit": false,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/assets/*": [
        "./assets/*"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/hooks/*": [
        "./hooks/*"
      ],
      "@/i18n/*": [
        "./i18n/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@/navigation/*": [
        "./navigation/*"
      ],
      "@/screens/*": [
        "./screens/*"
      ],
      "@/services/*": [
        "./services/*"
      ],
      "@/store/*": [
        "./store/*"
      ],
      "@/tests/*": [
        "./tests/*"
      ],
      "@/validator/*": [
        "./validator/*"
      ],
      "@/utils/*": [
        "./utils/*"
      ],
      "tailwind.config": [
        "./tailwind.config.js"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "./**/*",
    "./i18n/resources/**/*.json",
    "nativewind-env.d.ts",
    "assets/lottie/**/*.json"
  ],
  "exclude": [
    "node_modules"
  ]
}