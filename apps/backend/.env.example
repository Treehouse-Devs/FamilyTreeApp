# =============================================================================
# Deployment environment for the backend Compose stack.
# Copy to `.env` and fill in real values. This file is read by compose at
# `docker compose up`. NEVER commit the filled-in `.env`.
#
# Generate secrets with, e.g.:
#   openssl rand -hex 24   # POSTGRES_PASSWORD
#   openssl rand -hex 32   # JWT_SECRET
# =============================================================================

# --- Postgres (compose initializes the DB on first boot, fresh volume) ---
POSTGRES_USER=familytree
POSTGRES_PASSWORD=__GENERATE_WITH_openssl_rand_hex_24__
POSTGRES_DB=familytree

# --- Backend DB connection ---
# IMPORTANT: DB_USERNAME / DB_PASSWORD must match POSTGRES_USER / POSTGRES_PASSWORD.
# DB_HOST is forced to "db" by docker-compose.yml (the compose service name),
# so the value here is only used when running migrations via the entrypoint.
DB_HOST=db
DB_PORT=5432
DB_USERNAME=familytree
DB_PASSWORD=__SAME_AS_POSTGRES_PASSWORD__
DB_NAME=familytree

# --- Backend application ---
NODE_ENV=production
PORT=3000
# Public base URL used to build URLs for uploaded files.
APP_URL=http://<VPS_PUBLIC_IP>:3001
STORAGE_PROVIDER=local
JWT_SECRET=__GENERATE_WITH_openssl_rand_hex_32__

# --- Firebase Admin SDK (REQUIRED at boot or the app crash-loops) ---
FB_PROJECT_ID=
FB_CLIENT_EMAIL=
# Single line, keep the literal \n escape sequences — the app converts them.
# Example: -----BEGIN PRIVATE KEY-----\nABCD...\n-----END PRIVATE KEY-----\n
FB_PRIVATE_KEY=

# --- Firebase client SDK ---
FB_API_KEY=
FB_AUTH_DOMAIN=
FB_STORAGE_BUCKET=
FB_MESSAGING_SENDER_ID=
FB_APP_ID=
FB_MEASURMENT_ID=

# --- SMTP (email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Deployment knobs ---
# CI overrides this with an immutable commit-SHA tag during deployment.
# Images are transferred directly to the VPS; no container registry is used.
BACKEND_IMAGE=familytree/backend:bootstrap
# Host port to expose the backend on (http://<VPS_PUBLIC_IP>:3001).
BACKEND_PORT=3001
