<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="20px">Hello {{displayName}},</mj-text>
        <mj-text>
          Please verify your email address by clicking the button below:
        </mj-text>
        <mj-button href="{{link}}" background-color="#4CAF50">
          Verify Email
        </mj-button>
        <mj-text font-size="12px" color="#999">
          If you didn't request this, you can safely ignore it.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
